FC=mpif90
# Add source folder here
SOURCEDIR=THESOURCE
# Default flags, please adapt
# FLAGS for mpif90
# -fallow-argument-mismatch: gfortran >= 10 rejects calls to the same MPI routine
# with different buffer types (no interfaces with mpif.h); drop it for other compilers.
FCFLAGS=-O2 -mcmodel=medium -fallow-argument-mismatch -I$(SOURCEDIR)/matrix_parallel/

AR=ar
RM=rm
ARFLAGS=cr
RANLIB=ranlib
# set this to 1 if you want to use gfortran
# set both to 1 if you want to use mpifortran
NODEVICE=1
MPARALLEL=1

%.o: %.f90 $(DEPENDALL)
	${FC} -c ${FCFLAGS} $<


